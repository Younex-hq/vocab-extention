{
  "manifest_version": 3,
  "name": "Vocab & Notes - Study Vault",
  "version": "1.1.0",
  "description": "Capture vocabulary with translations and definitions, save notes, and export/import to Anki (.csv) or JSON.",
  "permissions": [
    "contextMenus",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["storage.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vocab & Notes",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vocab-notes@study-vault.extension",
      "strict_min_version": "109.0"
    }
  }
}
